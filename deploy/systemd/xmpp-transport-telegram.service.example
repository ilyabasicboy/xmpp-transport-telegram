[Unit]
Description=XMPP to Telegram transport
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=forking
User=xmpp-transport-telegram
Group=xmpp-transport-telegram
WorkingDirectory=/opt/xmpp-transport-telegram
ExecStart=/opt/xmpp-transport-telegram/venv/bin/python -m xmpp_transport_telegram --config /etc/xmpp-transport-telegram/config.ini --daemon
ExecStop=/opt/xmpp-transport-telegram/venv/bin/python -m xmpp_transport_telegram --config /etc/xmpp-transport-telegram/config.ini --stop
PIDFile=/opt/xmpp-transport-telegram/run/xmpp_transport_telegram.pid
Restart=on-failure
RestartSec=5
ReadWritePaths=/opt/xmpp-transport-telegram/logs /opt/xmpp-transport-telegram/run /opt/xmpp-transport-telegram/data

[Install]
WantedBy=multi-user.target
